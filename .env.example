# Optional settings. Without .env, the dashboard uses the defaults below.

# Web
# Listen address: 0.0.0.0 allows devices on your network; 127.0.0.1 is this PC only.
WEB_HOST=0.0.0.0
# Dashboard HTTPS port (default 7000).
WEB_PORT=7000

# Media search and info provider
# TMDB key: register to themoviedb.org and get token from Settings -> API
TMDB_API_KEY=

# Notifications (optional; leave tokens blank to disable)
# Telegram bot token: message @BotFather, send /newbot, and copy the token it gives you.
TELEGRAM_BOT_TOKEN=
# Telegram remote access: sign in at https://dashboard.ngrok.com/get-started/your-authtoken and copy your token.
NGROK_AUTHTOKEN=
# Local port for incoming Telegram commands through ngrok (default 7001).
NOTIFY_PORT=7001
